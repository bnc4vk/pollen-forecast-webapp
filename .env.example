CAMS_API_KEY=
GOOGLE_POLLEN_API_KEY=
TOMORROW_API_KEY=
POLLENINFORMATION_API_KEY=
ENABLE_TOMORROW_POLLEN=false
HOST=127.0.0.1
ALLOWED_ORIGIN=http://127.0.0.1:5173

# Optional for GitHub Pages or other static hosting.
# Point this at a deployed copy of server/index.js to keep Google/Tomorrow keys server-side.
VITE_API_BASE_URL=

# Do not use these public browser variables unless the provider keys are locked down
# by HTTP referrer/domain and quota restrictions. Values are embedded in the JS bundle.
VITE_GOOGLE_POLLEN_API_KEY=
VITE_TOMORROW_API_KEY=
VITE_ENABLE_TOMORROW_POLLEN=false

# Cloudflare Worker deployment.
# Store this outside git, for example in your shell environment.
CLOUDFLARE_API_TOKEN=
